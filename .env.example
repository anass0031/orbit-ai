# ─────────────────────────────────────────────────────────────
# ORBIT AI (semaine 4) — modèle de configuration.
# Copier en `.env` puis remplacer chaque valeur CHANGE_ME. Ne jamais committer `.env`.
# ─────────────────────────────────────────────────────────────
ORBIT_ENV=development
ORBIT_LOG_LEVEL=INFO

# Clé de signature des JWT. Générer : python -c "import secrets;print(secrets.token_urlsafe(48))"
ORBIT_JWT_SECRET=CHANGE_ME
# Durée de validité d'une connexion (minutes)
ORBIT_ACCESS_TOKEN_MINUTES=480
# Mot de passe des comptes de démo (admin@orbit.local, engineer@orbit.local, analyst@orbit.local)
ORBIT_DEMO_PASSWORD=CHANGE_ME

# Base de métadonnées PostgreSQL (port hôte 5433)
POSTGRES_USER=orbit
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=orbit
POSTGRES_HOST_PORT=5433
# Utilisé quand le backend tourne sur le PC (hors Docker). Dans Docker, docker-compose.yml le remplace.
ORBIT_DATABASE_URL=postgresql+psycopg://orbit:CHANGE_ME@localhost:5433/orbit

# Stockage objet MinIO (lakehouse). Console web : http://localhost:9001
MINIO_ROOT_USER=orbitminio
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
ORBIT_STORAGE_BACKEND=s3
ORBIT_S3_ENDPOINT=http://localhost:9000
ORBIT_S3_BUCKET=orbit-lakehouse
ORBIT_S3_ACCESS_KEY=orbitminio
ORBIT_S3_SECRET_KEY=CHANGE_ME
ORBIT_DATA_DIR=./data/runtime

# File de tâches Redis (exécution des pipelines par le worker Celery). Port hôte 6380 (6379 souvent pris sous Windows).
REDIS_HOST_PORT=6380
# Utilisé quand le backend tourne sur le PC (hors Docker). Dans Docker, docker-compose.yml le remplace.
ORBIT_REDIS_URL=redis://localhost:6380/0
# true = les pipelines s'exécutent dans le processus de l'API (sans worker). false = envoyés au worker Celery.
ORBIT_TASKS_EAGER=false
# Nombre maximal de tentatives par exécution (première + relances)
ORBIT_MAX_RUN_ATTEMPTS=3

# Limites
ORBIT_UPLOAD_MAX_MB=100
ORBIT_PREVIEW_ROWS=50

# Réseau : adresse d'écoute des ports publiés. 127.0.0.1 = ce PC uniquement (recommandé).
BIND_ADDRESS=127.0.0.1

# Frontend / API
FRONTEND_HOST_PORT=3000
API_HOST_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Adresses autorisées à appeler l'API depuis un navigateur (séparées par des virgules)
ORBIT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Outils de pipeline
# E-mails (rapports, notifications). Docker : le serveur local Mailpit reçoit tout (boîte : http://localhost:8025).
# Hors Docker : ORBIT_SMTP_HOST=localhost et ORBIT_SMTP_PORT=1025 (Mailpit lancé par Docker), ou votre serveur SMTP.
ORBIT_SMTP_HOST=localhost
ORBIT_SMTP_PORT=1025
ORBIT_SMTP_TLS=false
ORBIT_SMTP_FROM=orbit@localhost
ORBIT_SMTP_USER=
ORBIT_SMTP_PASSWORD=
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025
# Dossier partagé qui reçoit une copie de chaque fichier exporté (Docker : ./exports dans ce dossier)
ORBIT_EXPORT_HOST_DIR=./exports
# Nœud « Python transform » (code pandas en bac à sable) : true / false
ORBIT_PYTHON_TRANSFORM_ENABLED=true
# Adresse de l'interface, utilisée dans les liens des e-mails et notifications
ORBIT_PUBLIC_URL=http://localhost:3000
